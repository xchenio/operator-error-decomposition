# Python caches and local tooling
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/

# Editor and operating-system files
.vscode/
.idea/
.DS_Store
Thumbs.db

# Transient experiment runtime files. Curated result artifacts are versioned.
results/**/checkpoints/
results/**/tensorboard/
*.tmp
*.lock

# Downloaded public benchmark datasets are reproducible by provenance, not committed binaries.
external_data/
external_data_*

# LaTeX build artefacts. The arXiv source is versioned, the PDF it produces is not.
paper/arxiv/*.aux
paper/arxiv/*.log
paper/arxiv/*.out
paper/arxiv/*.toc
paper/arxiv/*.pdf
